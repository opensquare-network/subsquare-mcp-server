# MCP HTTP server
PORT=3210

# Default chain used when a tool call omits the chain parameter
SUBSQUARE_DEFAULT_CHAIN=polkadot

# One SubSquare API base URL per supported chain
SUBSQUARE_API_URL_POLKADOT=https://polkadot-api.subsquare.io
SUBSQUARE_API_URL_COLLECTIVES=https://collectives-api.subsquare.io
SUBSQUARE_API_URL_HYDRATION=https://hydration-api.subsquare.io
SUBSQUARE_API_URL_KUSAMA=https://kusama-api.subsquare.io

# Dot Treasury GraphQL API URL
DOT_TREASURY_GRAPHQL_URL=https://eco-api.dotreasury.com/graphql

# Identifiers for the SubSquare API endpoints
SUBSQUARE_IDENTITY_SERVER_URL=https://id2.statescan.io
